{
  "name": "mcd-cheap-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discover the cheapest verified McDonald's item nearby, without choosing food first.",
  "engines": {"node": ">=22.9.0"},
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "demo": "node src/cli.mjs demo",
    "probe": "node --env-file-if-exists=.env src/cli.mjs probe",
    "scan": "node --env-file-if-exists=.env src/cli.mjs scan",
    "check": "node scripts/check.mjs"
  },
  "license": "MIT"
}
